DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardian_db
DB_USER=postgres
DB_PASSWORD=123456
SERVER_PORT=8081

FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_JSON=
# Si quieres usar archivo local, descomenta la siguiente línea:
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/manto-app-firebase-adminsdk.json
# Alternativa a archivo local:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

GOOGLE_SAFE_BROWSING_ENABLED=true
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_BASE_URL=https://safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_CLIENT_ID=guardian-api
GOOGLE_SAFE_BROWSING_CLIENT_VERSION=1.0.0

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=secrets/google-drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=root
